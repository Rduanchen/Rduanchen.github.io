---
import "../styles/global.css";
import Navigation from "../components/system/Navigation.vue";
import { ClientRouter } from "astro:transitions";
import { defaultLang } from "../i18n/porfolio";

interface Props {
  title?: string;
}

const { title = "Rduan's portfolio" } = Astro.props as Props;
const currentLang = Astro.currentLocale || defaultLang;
---

<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches;

        if (storedTheme === "dark" || (!storedTheme && systemTheme)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body>
    <Navigation client:load currentLang={currentLang} />
    <main class="relative w-full">
      <section class="relative z-10">
        <slot />
      </section>
    </main>
  </body>
</html>