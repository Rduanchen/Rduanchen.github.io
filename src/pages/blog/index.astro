---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");
posts = posts.filter(post => post.id.endsWith('/en'));
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.map(post => post.data.tags || []).flat())];
---

<BlogLayout title="Blog | Rduan">
  <div class="mx-auto max-w-4xl px-6 py-12">
    <header class="mb-8">
      <p class="text-sm uppercase tracking-wide text-muted-foreground">Writing</p>
      <h1 class="text-4xl font-bold tracking-tight">My Blog</h1>
    </header>

    <!-- Pagefind Search Box -->
    <div
      id="search"
      class="mb-8 w-full rounded-xl border border-border/70 bg-card/80 p-4 shadow-lg shadow-slate-300/30 backdrop-blur dark:shadow-black/30"
    >
    </div>

    <!-- Tags Filter -->
    <div class="mb-10 flex flex-wrap gap-2" id="tag-filters">
      <button
        class="tag-btn cursor-pointer rounded-full bg-primary px-3 py-1 text-sm text-primary-foreground transition-colors"
        data-tag="all"
      >
        All
      </button>
      {allTags.map(tag => (
        <button
          class="tag-btn cursor-pointer rounded-full bg-secondary px-3 py-1 text-sm text-secondary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          data-tag={tag}
        >
          {tag}
        </button>
      ))}
    </div>

    <div class="space-y-6" id="blog-posts">
      {posts.map(post => (
        <article
          class="blog-post rounded-xl border border-border/70 bg-card/90 p-6 shadow-lg shadow-slate-300/30 backdrop-blur transition-colors hover:border-border dark:shadow-black/35"
          data-tags={(post.data.tags || []).join(',')}
        >
          <h2 class="mb-2 text-2xl font-semibold">
            <a href={`/blog/${post.id.replace('/en', '')}`} class="transition-colors hover:text-primary">
              {post.data.title}
            </a>
          </h2>
          <p class="mb-4 text-muted-foreground">{post.data.description}</p>
          <div class="flex items-center gap-4 text-sm text-muted-foreground">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString()}
            </time>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex gap-2">
                {post.data.tags.map(tag => (
                  <span class="rounded bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
      <div id="no-posts" class="hidden py-8 text-center text-muted-foreground">No posts found with this tag.</div>
    </div>
  </div>

  <!-- Load Pagefind UI assets -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <script src="/pagefind/pagefind-ui.js" is:inline></script>

  <script is:inline>
    // 使用 astro:page-load 確保在 View Transitions 切換後依然能執行
    document.addEventListener('astro:page-load', () => {
      // Initialize Pagefind Search
      if (typeof PagefindUI !== 'undefined') {
        const searchContainer = document.getElementById('search');
        // 避免重複初始化
        if (searchContainer && searchContainer.innerHTML === '') {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            bundlePath: "/pagefind/" // 確保在任何路徑下都能正確載入 Pagefind bundle
          });
        }
      }

      // Tag Filtering Logic
      const buttons = document.querySelectorAll('.tag-btn');
      const posts = document.querySelectorAll('.blog-post');
      const noPostsMsg = document.getElementById('no-posts');

      const activeClasses = ['bg-primary', 'text-primary-foreground'];
      const idleClasses = ['bg-secondary', 'text-secondary-foreground', 'hover:bg-accent', 'hover:text-accent-foreground'];

      const params = new URLSearchParams(window.location.search);
      const initialTag = params.get('tag');

      function filterPosts(targetTag) {
        let visibleCount = 0;

        buttons.forEach(btn => {
          if (btn.dataset.tag === targetTag) {
            btn.classList.add(...activeClasses);
            btn.classList.remove(...idleClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...idleClasses);
          }
        });

        posts.forEach(post => {
          if (targetTag === 'all') {
            post.style.display = 'block';
            visibleCount++;
          } else {
            const tags = post.dataset.tags ? post.dataset.tags.split(',') : [];
            if (tags.includes(targetTag)) {
              post.style.display = 'block';
              visibleCount++;
            } else {
              post.style.display = 'none';
            }
          }
        });

        if (visibleCount === 0) {
          if(noPostsMsg) noPostsMsg.classList.remove('hidden');
        } else {
          if(noPostsMsg) noPostsMsg.classList.add('hidden');
        }
      }

      buttons.forEach(btn => {
        // 避免重複綁定，可以先移除舊的 event listener 或只在未綁定時綁定
        // 但因為 Astro View Transitions 會替換 DOM，所以重新綁定是安全的
        btn.addEventListener('click', () => {
          const tag = btn.dataset.tag;
          const newUrl = tag === 'all' ? window.location.pathname : `${window.location.pathname}?tag=${tag}`;
          window.history.pushState({}, '', newUrl);
          filterPosts(tag);
        });
      });

      if (initialTag) {
        filterPosts(initialTag);
      }
    });
  </script>
</BlogLayout>
