---
import { getCollection } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import CardSpotlight from "../../components/inspira/CardSpotlight.vue";
import LampEffect from "../../components/inspira/LampEffect.vue";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const locale = Astro.currentLocale === "zh-tw" ? "zh-TW" : "en-US";
---

<ContentLayout title="Projects | Rduan">
  <LampEffect client:load class="min-h-screen">
    <div class="mx-auto w-full max-w-6xl px-4 pb-12 md:px-6 lg:pb-16">
      <div class="mb-10 flex w-full justify-center">
        <div class="text-center">
          <p class="text-lg text-zinc-700 dark:text-zinc-300">Project Archive</p>
          <h1 class="text-5xl font-bold tracking-tight text-zinc-900 dark:text-white md:text-4xl">Projects</h1>
        </div>
      </div>
      <ul class="mt-10 grid list-none gap-6 p-0 md:grid-cols-2">
        {projects.map((post) => (
          <li class="h-full">
            <a href={`/projects/${post.id}/`} class="block h-full">
              <CardSpotlight
                client:load
                class="h-full p-6 bg-card/95 ring-1 ring-border/70 shadow-xl shadow-black/20 dark:shadow-black/55 backdrop-blur-sm"
                gradient-color="var(--card-spotlight)"
              >
                <div class="flex h-full flex-col gap-4">
                  <div class="space-y-2">
                    <p class="text-xs text-muted-foreground">
                      {post.data.pubDate.toLocaleDateString(locale, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </p>
                    <h2 class="text-xl font-semibold leading-tight">{post.data.title}</h2>
                    <p class="line-clamp-3 text-sm text-muted-foreground">{post.data.description}</p>
                  </div>

                  <div class="mt-auto flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span
                        class="rounded-full border border-zinc-700 bg-zinc-900/90 px-2.5 py-1 text-xs font-medium text-zinc-100 shadow-sm shadow-black/30 dark:border-zinc-500 dark:bg-zinc-800 dark:text-zinc-100"
                      >
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>
              </CardSpotlight>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </LampEffect>
</ContentLayout>

<style is:global>
  :root {
    --card-spotlight: #a5b4fc;
  }

  .dark {
    --card-spotlight: #1d4ed8;
  }
</style>
