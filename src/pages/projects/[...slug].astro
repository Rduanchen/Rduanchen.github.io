---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"projects">;

const post = Astro.props as Props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((heading) => heading.depth <= 2);
const subtitle = post.data.subtitle ?? post.data.description;

const locale = Astro.currentLocale === "zh-tw" ? "zh-TW" : "en-US";
---

<ContentLayout title={`${post.data.title} | Projects`}>
  <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(148,163,184,0.28),transparent_55%),linear-gradient(180deg,#f8fafc_0%,#eef2ff_50%,#e2e8f0_100%)] dark:bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.14),transparent_55%),linear-gradient(180deg,#09090b_0%,#0f172a_50%,#020617_100%)]" />

  <div class="mx-auto grid w-full max-w-7xl grid-cols-1 justify-center gap-8 px-4 py-10 md:px-6 lg:grid-cols-[220px_minmax(0,820px)] lg:gap-12 lg:py-14">
    <aside class="hidden lg:block">
      {tocItems.length > 0 && (
        <nav class="sticky top-24 rounded-xl border border-border/70 bg-white/90 p-4 shadow-lg shadow-slate-300/40 backdrop-blur dark:bg-zinc-900/90 dark:shadow-black/30">
          <p class="mb-3 text-xs font-medium uppercase tracking-wide text-muted-foreground">On this page</p>
          <ul class="space-y-1">
            {tocItems.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  data-heading-id={heading.slug}
                  class:list={[
                    "block rounded px-2 py-1 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground",
                    heading.depth === 2 && "pl-5",
                  ]}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </aside>

    <article class="mx-auto w-full rounded-2xl border border-border/70 bg-white/95 p-5 shadow-2xl shadow-slate-300/35 dark:bg-zinc-900/95 dark:shadow-black/45 md:p-8">
      <a
        href="/projects"
        class="mb-6 inline-flex rounded-md border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        ← Back to projects
      </a>

      {post.data.image && (
        <Image
          src={post.data.image}
          alt={`${post.data.title} cover image`}
          class="mb-8 h-50 w-full rounded-xl object-cover md:h-80"
        />
      )}

      <header class="mb-8 border-b border-border pb-6">
        <p class="mb-2 text-sm text-muted-foreground">
          {post.data.pubDate.toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{post.data.title}</h1>
        <p class="mt-3 text-base text-muted-foreground md:text-lg">{subtitle}</p>

        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span
              class="rounded-full border border-zinc-700 bg-zinc-900/90 px-2.5 py-1 text-xs font-medium text-zinc-100 shadow-sm shadow-black/30 dark:border-zinc-500 dark:bg-zinc-800 dark:text-zinc-100"
            >
              #{tag}
            </span>
          ))}
        </div>
      </header>

      <div class="prose prose-slate max-w-none dark:prose-invert lg:prose-lg">
        <Content />
      </div>
    </article>
  </div>

  {tocItems.length > 0 && (
    <script is:inline>
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      const sections = tocLinks
        .map((link) => {
          const id = link.getAttribute('data-heading-id');
          if (!id) return null;
          const section = document.getElementById(id);
          if (!section) return null;
          return { id, section, link };
        })
        .filter(Boolean);

      const setActive = (id) => {
        sections.forEach((item) => {
          if (!item) return;
          const active = item.id === id;
          item.link.classList.toggle('bg-accent', active);
          item.link.classList.toggle('text-accent-foreground', active);
          item.link.classList.toggle('font-semibold', active);
          item.link.classList.toggle('text-muted-foreground', !active);
        });
      };

      if (sections.length > 0) {
        setActive(sections[0]?.id);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: '-25% 0px -55% 0px',
          threshold: [0, 1],
        }
      );

      sections.forEach((item) => {
        if (!item) return;
        observer.observe(item.section);
      });
    </script>
  )}
</ContentLayout>
